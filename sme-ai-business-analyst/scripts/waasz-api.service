[Unit]
Description=Waasz AI WhatsApp FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Waasz-AI-Business-Analyst/sme-ai-business-analyst
EnvironmentFile=/home/ubuntu/Waasz-AI-Business-Analyst/sme-ai-business-analyst/.env
ExecStart=/home/ubuntu/Waasz-AI-Business-Analyst/sme-ai-business-analyst/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
StandardOutput=append:/home/ubuntu/Waasz-AI-Business-Analyst/sme-ai-business-analyst/uvicorn.log
StandardError=append:/home/ubuntu/Waasz-AI-Business-Analyst/sme-ai-business-analyst/uvicorn.log

[Install]
WantedBy=multi-user.target
