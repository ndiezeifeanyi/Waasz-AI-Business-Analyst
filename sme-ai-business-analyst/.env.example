ss# ============================================================================
# SME AI BUSINESS ANALYST PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# CRITICAL: Never commit actual secrets to version control.
# Copy this file to .env and fill in your actual values.
# All values marked [REQUIRED] must be set before deployment.
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=SME AI Business Analyst Platform
APP_ENV=local                             # Options: local, test, staging, production
APP_DEBUG=false                           # DANGER: Never true in production!
APP_BASE_URL=http://localhost:8000        # Your application URL
SECRET_KEY=                               # [REQUIRED] Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ALLOWED_HOSTS=localhost,127.0.0.1         # Comma-separated list of allowed hosts
CORS_ORIGINS=http://localhost:8501,http://localhost:3000  # Comma-separated CORS origins

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Use PostgreSQL (Supabase recommended for quick setup)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=                             # [REQUIRED] Async connection string
SYNC_DATABASE_URL=                        # [REQUIRED] Sync connection string (for migrations)
DATABASE_POOL_SIZE=20                     # Connection pool size
DATABASE_MAX_OVERFLOW=10                  # Maximum overflow connections

# ============================================================================
# WHATSAPP CLOUD API CONFIGURATION
# ============================================================================
# Setup instructions: https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_VERIFY_TOKEN=                    # [REQUIRED] Your webhook verify token (you create this)
WHATSAPP_APP_SECRET=                      # [REQUIRED] From Meta App Settings
WHATSAPP_ACCESS_TOKEN=                    # [REQUIRED] From Meta App > WhatsApp > Configuration
WHATSAPP_PHONE_NUMBER_ID=                 # [REQUIRED] Your WhatsApp Business Phone Number ID
WHATSAPP_API_VERSION=v20.0                # Meta API version

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================
# At least one provider [REQUIRED] in production. In local mode, fallback to heuristic extraction.

# Google Gemini (Recommended - free tier available)
GEMINI_API_KEY=                           # Get from: https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-1.5-flash             # Latest fast model

# Groq (Free, fast alternative)
GROQ_API_KEY=                             # Get from: https://console.groq.com/keys
GROQ_MODEL=llama-3.1-70b-versatile        # Fast 70B model

# OpenAI (Fallback provider)
OPENAI_API_KEY=                           # Get from: https://platform.openai.com/api-keys
OPENAI_FALLBACK_MODEL=gpt-4o-mini         # Cost-effective model

# ============================================================================
# OCR AND VOICE TRANSCRIPTION
# ============================================================================
# Google Vision API for OCR fallback
GOOGLE_APPLICATION_CREDENTIALS=           # Path to service account JSON file

# Tesseract OCR (optional, for offline OCR)
TESSERACT_CMD=                            # Path to tesseract executable (if installed)

# Local media storage
MEDIA_DOWNLOAD_DIR=local_media            # Directory for temporary media downloads

# ============================================================================
# COST MONITORING AND LIMITS
# ============================================================================
DAILY_AI_SPEND_LIMIT_USD=5.00             # Daily spend limit per business
MONTHLY_AI_SPEND_LIMIT_USD=100.00         # Monthly spend limit per business
AI_COST_ALERT_EMAIL=                      # Email to alert when approaching limits

# ============================================================================
# SECURITY AND RATE LIMITING
# ============================================================================
RATE_LIMIT_PER_MINUTE=30                  # Requests per minute per IP
MAX_MESSAGE_LENGTH=4000                   # Maximum WhatsApp message length
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=86400     # Idempotency key cache TTL (24 hours)

# ============================================================================
# REPORT SCHEDULING
# ============================================================================
DAILY_REPORT_HOUR_LOCAL=21                # Hour to send daily report (0-23, local timezone)
WEEKLY_REPORT_WEEKDAY=6                   # Day to send weekly report (0=Monday, 6=Sunday)
LOCAL_TIMEZONE=Africa/Lagos               # Business timezone for scheduling

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================
SENTRY_DSN=                               # Optional: Sentry error tracking
LOG_LEVEL=INFO                            # Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
